datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  passwordHash  String?
  authProvider  String       @default("password")
  birthDate     DateTime?    @db.Date
  role          String       @default("student") // "student" ou "teacher"
  questions     Question[]
  aiMessages    AiMessage[]
  videoProgress VideoProgress[]
  topics        Topic[]
  topicMessages TopicMessage[]
  topicReads    TopicRead[]
  passwordResetTokens PasswordResetToken[]
  createdAt     DateTime     @default(now())
}

model Module {
  id          String   @id @default(uuid())
  order       Int      // posição/ordem de exibição (1 a 10)
  name        String
  description String?
  synopsis    String?  // resumo gerado pela IA do que será estudado no PDF
  content     String?  // JSON com submódulos: [{title, content, images}]
  pdfUrl      String?
  videos      Video[]
  aiMessages  AiMessage[]
  createdAt   DateTime @default(now())
}

model Question {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionText String
  answerText   String?
  status       String   @default("open") // "open" ou "answered"
  createdAt    DateTime @default(now())
}

model AiMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role      String // "user" ou "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, moduleId])
}

model Video {
  id          String   @id @default(uuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String
  thumbnail   String?
  duration    Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  progress    VideoProgress[]
}

model VideoProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watched   Boolean  @default(false)
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
}

model Topic {
  id          String         @id @default(uuid())
  title       String
  description String
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages    TopicMessage[]
  reads       TopicRead[]
  createdAt   DateTime       @default(now())

  @@index([createdAt])
}

model TopicMessage {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, createdAt])
}

model TopicRead {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([userId, topicId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}
