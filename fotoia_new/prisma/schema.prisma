datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Plan {
  FREE
  FULL
}

enum PromptType {
  EDITING
  CREATION
}

model User {
  id            String       @id @default(uuid())
  name          String
  email         String       @unique
  passwordHash  String?
  authProvider  String       @default("password")
  birthDate     DateTime?    @db.Date
  gender        String?
  role          String       @default("student") // "student" ou "teacher"
  plan          Plan         @default(FREE)
  purchasedAt   DateTime?
  refundedAt    DateTime?
  questions     Question[]
  answeredQuestions Question[] @relation("QuestionAnsweredBy")
  aiMessages    AiMessage[]
  videoProgress VideoProgress[]
  topics        Topic[]
  topicMessages TopicMessage[]
  topicReads    TopicRead[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  paymentTransactions PaymentTransaction[]
  emailVerifiedAt DateTime?
  createdAt     DateTime     @default(now())
}

model Module {
  id          String   @id @default(uuid())
  order       Int      // posição/ordem de exibição (1 a 10)
  name        String
  description String?
  synopsis    String?  // resumo gerado pela IA do que será estudado no PDF
  content     String?  // JSON com submódulos: [{title, content, images}]
  pdfUrl      String?
  isFree      Boolean  @default(true)
  videos      Video[]
  aiMessages  AiMessage[]
  createdAt   DateTime @default(now())
}

model Question {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionText String
  answerText   String?
  status       String   @default("open") // "open" ou "answered"
  answeredById String?
  answeredBy   User?    @relation("QuestionAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?
  createdAt    DateTime @default(now())
}

model AiMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  role      String // "user" ou "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, moduleId])
}

model Video {
  id          String   @id @default(uuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String
  thumbnail   String?
  duration    Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  progress    VideoProgress[]
}

model VideoProgress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watched   Boolean  @default(false)
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
}

model Topic {
  id          String         @id @default(uuid())
  title       String
  description String
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages    TopicMessage[]
  reads       TopicRead[]
  createdAt   DateTime       @default(now())

  @@index([createdAt])
}

model TopicMessage {
  id        String   @id @default(uuid())
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, createdAt])
}

model TopicRead {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([userId, topicId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model PaymentTransaction {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String    @default("mercado_pago")
  externalReference String    @unique
  orderId           String?   @unique
  paymentId         String?   @unique
  amountCents       Int
  currency          String    @default("BRL")
  status            String    @default("created")
  statusDetail      String?
  purchasedAt       DateTime?
  refundedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
}

model PromptCategory {
  id        String     @id @default(uuid())
  name      String
  type      PromptType
  order     Int        @default(0)
  prompts   Prompt[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([type, name])
  @@index([type, order])
}

model Prompt {
  id          String         @id @default(uuid())
  categoryId  String
  category    PromptCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  imageUrl    String
  imageSourceUrl String?
  imageAuthor String?
  imageLicense String?
  pdfUrl      String
  description String
  promptText  String         @db.Text
  isFree      Boolean        @default(false)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId, order])
}
